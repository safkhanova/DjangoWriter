# Site configuration. `manage.py init_instance` copies this to instance/.env
# and fills SECRET_KEY. The instance folder is private: never commit it.
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SITE_URL=https://example.com
# Shown in the admin header and in login e-mails (default: the host of SITE_URL)
SITE_LABEL=example.com
TIME_ZONE=Asia/Baku
# Admin path (keep the trailing slash).
ADMIN_URL=admin/

# Leave unset for SQLite in instance/db.sqlite3 (development)
DATABASE_URL=postgres://site:PASSWORD@127.0.0.1:5432/site
# Default: instance/media
# MEDIA_ROOT=/var/www/example.com/media

# Gmail: EMAIL_HOST=smtp.gmail.com, port 587 + TLS, EMAIL_HOST_PASSWORD = 16-letter App Password
# (Google account > Security > 2-Step Verification > App passwords), no spaces.
# DEFAULT_FROM_EMAIL must be the same Gmail address, or Gmail rewrites/flags the sender.
# Format: KEY=value, no spaces around "=" and no quotes.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Site Name <noreply@example.com>
NEWSLETTER_BATCH_SIZE=100

# Header holding the real client IP (nginx: X-Real-IP; Cloudflare: HTTP_CF_CONNECTING_IP)
EMAILOTP_IP_HEADER=HTTP_X_REAL_IP
# Enable (31536000) once HTTPS is confirmed working.
SECURE_HSTS_SECONDS=0
# Extra script origins allowed by the public Content-Security-Policy (analytics), comma separated.
# The analytics snippet must load an external script (<script src=...>); inline scripts are blocked.
CSP_EXTRA_SCRIPT_SRC=
